# Copy to .env and fill in. NEVER commit a real key.
# Without a key TrueUp runs on the deterministic stub and every test still passes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to force the stub even when a key is present.
TRUEUP_DISABLE_LLM=0

# TRUEUP_DATABASE_URL=sqlite:///trueup.db
