# LLM: OpenAI directly, or OpenAI gpt-oss on AWS Bedrock (used only when OPENAI_API_KEY is unset)
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
# Optional model override (Bedrock default: openai.gpt-oss-120b-1:0, OpenAI default: gpt-5)
MODEL_ID=

# Jev (TypeSafe System One) for the classifier second opinion
TYPESAFE_API_KEY=

# Optional tracing
NEATLOGS_API_KEY=

# SQLite path
TRUEUP_DB=trueup.db
